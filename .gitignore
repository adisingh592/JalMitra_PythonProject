# ------------------------------------------------------------
# Only track frontend/ and backend/ (database SQL lives in backend/sql/)
# Ignore everything else at the repo root.
# ------------------------------------------------------------
/*
!/.gitignore
!/frontend/
!/backend/
!/requirements.txt
!/README.md

# Scripts / local helpers (anywhere)
*.bat
*.cmd
*.ps1
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env
!.env.example

# Database files (SQL schema in backend/sql/ is kept)
*.db
*.sqlite3

# Node.js / Vite
node_modules/
dist/
build/
.vite/
.pnpm-store/

# IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Backend local test scripts
backend/test_*.py

# Frontend template leftovers (not needed to run the app)
frontend/guidelines/
frontend/default_shadcn_theme.css
frontend/pnpm-workspace.yaml
frontend/ATTRIBUTIONS.md
